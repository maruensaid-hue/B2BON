# Fallback de dev — franquia real vem do nucleo via PlanLimitsProvider
FRANQUIA_CONTAS_MES_STUB_DEFAULT=50

MATERIAIS_STORAGE_PATH=./storage/materiais

# Vazio ate a integracao real com o nucleo B2B ON existir
CORE_API_BASE_URL=

# Vazio usa StubWhatsAppProvider em dev/teste
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Vazio usa StubEmailProvider em dev/teste
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Trocar em producao — assina tokens de opt-out
SECRET_KEY=changeme-dev-secret-key

# Vazio usa StubCalendarProvider em dev/teste
GOOGLE_CALENDAR_ACCESS_TOKEN=
