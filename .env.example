APP_ENV=development
DATABASE_URL=sqlite:///./predator.db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fallback de dev — franquia real vem do nucleo via PlanLimitsProvider
FRANQUIA_CONTAS_MES_STUB_DEFAULT=50

MATERIAIS_STORAGE_PATH=./storage/materiais

# Vazio ate a integracao real com o nucleo B2B ON existir
CORE_API_BASE_URL=

# Vazio usa StubWhatsAppProvider em dev/teste
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Criptografa em repouso as credenciais Meta de ConfiguracaoWhatsApp
# (achado do raio-X de compliance). Gerar com `python -c "from
# cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Vazio em producao recusa subir (ver app/core/crypto.py).
CONFIGURACAO_WHATSAPP_ENCRYPTION_KEY=

# Vazio usa StubEmailProvider em dev/teste
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Trocar em producao — assina tokens de opt-out
SECRET_KEY=changeme-dev-secret-key

# Vazio usa StubCalendarProvider em dev/teste
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

LIMIAR_QUALIFICACAO_PADRAO=60.0

# Autenticacao real do nucleo (Onda A) — trocar em producao, minimo 32 bytes
JWT_SECRET_KEY=changeme-dev-jwt-secret-key-min-32-bytes-long
JWT_EXPIRACAO_MINUTOS=1440
GOOGLE_OAUTH_CLIENT_ID=

# Limiares de alerta de risco de churn dos tenants — MAP, visao do
# super_admin sobre os assinantes da B2B ON (Onda D)
LIMIAR_RISCO_CRITICO_TENANT=75.0
LIMIAR_RISCO_ATENCAO_TENANT=45.0

# Mesma logica acima, aplicada as CONTAS de um tenant — MAP de contas,
# visivel a user/admin/super_admin dentro do proprio tenant
LIMIAR_RISCO_CRITICO_CONTA=75.0
LIMIAR_RISCO_ATENCAO_CONTA=45.0

# Origens do frontend autorizadas a chamar a API (CORS) — lista em
# formato JSON. Vite dev server por padrao (Onda F1).
CORS_ORIGINS=["http://localhost:5173"]

# Segredo do disparador de envio agendado (Onda I) — POST
# /cron/processar-envios recusa sempre que estiver vazio. Gerar com
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` e usar
# o mesmo valor no repo secret CRON_SECRET do GitHub Actions.
CRON_SECRET=

# Webhook da Meta (WhatsApp Cloud API): App Secret do app, usado para validar a assinatura X-Hub-Signature-256
# de cada POST em /webhooks/whatsapp/meta. Vazio = webhook recusado (falha fechada). Meta for Developers >
# App settings > Basic > App secret.
WHATSAPP_APP_SECRET=

# Segredo dos webhooks INTERNOS (/webhooks/whatsapp, /webhooks/email, /webhooks/reputacao), enviado no cabecalho
# X-Webhook-Secret. Nenhum provedor chama essas rotas; vazio = recusadas. Gerar com secrets.token_urlsafe(32).
WEBHOOK_INTERNO_SECRET=

# URL publica onde a propria API responde (sem barra no final) — usada
# para montar links/pixel absolutos dentro do corpo de e-mails (opt-out,
# rastreio de abertura, reagendamento de reuniao). Em producao, a URL do
# servico no Render + /api/v1.
URL_BASE_API=http://localhost:8000/api/v1

# Tempo maximo que uma migracao espera por uma tabela em uso (so PostgreSQL; padrao 30s). Passou disso, a migracao falha em segundos e o deploy nao vai ao ar,
# em vez de ficar pendurado ate o prazo do Render. Formato: 500ms, 30s, 2min.
# ALEMBIC_LOCK_TIMEOUT=30s

# RLS (D-110): papel dono das tabelas, usado SÓ pelo Alembic. Com ele definido, DATABASE_URL passa a ser o papel de execução (b2bon_app, sem BYPASSRLS).
# Vazio = o Alembic usa DATABASE_URL (comportamento de antes do RLS). Passo a passo em docs/b2bon/RLS.md.
# MIGRATION_DATABASE_URL=postgresql://dono:senha@host/banco?sslmode=require

# --- Exemplo de producao (Onda G) — NAO sao segredos reais, so mostram o formato ---
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/predator?sslmode=require
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# CORS_ORIGINS=["https://b2bon.pages.dev"]
